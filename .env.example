# Supabase (https://supabase.com/dashboard) — required for auth + gallery DB
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Netlify Functions only (never expose in Vite / browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Sheets OAuth (browser) — Effective Paths sync (LAB → Effective Paths sync…)
# Create separate Web clients for production and local dev (Google OAuth policy).
#
# Production client ("TowerSmith"):
#   - Authorized JavaScript origins: https://www.towersmith.com only
#   - Authorized redirect URIs: https://www.towersmith.com/oauth/google-drive-picker only
#   - Do NOT add http://127.0.0.1, http://localhost, or LAN IPs — Google flags loopback on production web clients
#
# Dev client ("TowerSmith Dev", optional):
#   - JavaScript origins: http://localhost:8888, http://localhost:5173 (and LAN IP if phone testing)
#   - Redirect URIs: http://localhost:8888/oauth/google-drive-picker, etc.
#   - Use a different VITE_GOOGLE_SHEETS_OAUTH_CLIENT_ID in local .env
#
# Enable Google Sheets API + Google Picker API in the project.
# Create a browser-restricted API key for the Picker (same project).
# Enable APIs in Library first (APIs & Services → Library → Enable), then they appear on the key:
#   Google Picker API, Google Drive API (required for Picker), Google Sheets API (for Functions).
# API key — Application restrictions: HTTP referrers, e.g.:
#   http://localhost:8888/*   http://localhost:5173/*   https://www.towersmith.com/*
# API key — API restrictions: Google Picker API + Google Drive API, OR "Don't restrict key"
#   (HTTP referrer restriction alone is enough for a browser key).
# Diagnose locally: node scripts/check-google-picker-key.mjs
# Use Chrome or Firefox — embedded IDE browsers cannot complete OAuth.
# Scope requested at runtime: https://www.googleapis.com/auth/drive.file (per-file via Google Picker on all platforms)
# Import/export calls Netlify Functions; OAuth access token is passed from the browser.
# VITE_GOOGLE_SHEETS_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VITE_GOOGLE_PICKER_API_KEY=your-browser-api-key
# Netlify Functions only — GIS authorization-code exchange (never expose in Vite / browser):
# GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=your-client-secret
# GOOGLE_SHEETS_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Required for the desktop JS Picker overlay (numeric Google Cloud project number, not the OAuth client ID):
# VITE_GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
# Optional redirect URIs for JS Picker fallback (one-pick OAuth when the overlay cannot open):
#   https://www.towersmith.com/oauth/google-drive-picker
#   http://localhost:5173/oauth/google-drive-picker
#   http://localhost:8888/oauth/google-drive-picker
#   http://YOUR_LAN_IP:8888/oauth/google-drive-picker   (phone testing — same IP as in browser URL)
# Add matching JavaScript origins for every host above (no path).

# Phone testing against `npm run dev:netlify` on your LAN (optional):
# VITE_DEV_PUBLIC_ORIGIN=http://192.168.1.42:8888
# Also add that URL in Supabase → Auth → URL Configuration → Redirect URLs: http://192.168.1.42:8888/**
# Production Netlify: pin OAuth redirect_uri to your canonical host (avoids www/naked mismatch):
# VITE_PUBLIC_APP_ORIGIN=https://www.towersmith.com

# Cross-Account Protection (RISC) — Netlify Functions only
# Comma-separated OAuth 2.0 Web client IDs from the same GCP project (production + dev clients).
# GOOGLE_RISC_OAUTH_CLIENT_IDS=prod-id.apps.googleusercontent.com,dev-id.apps.googleusercontent.com
# One-time registration (maintainer machine only — never commit the service-account JSON):
#   GOOGLE_RISC_SERVICE_ACCOUNT_PATH=/path/to/risc-admin-key.json node scripts/register-google-risc.mjs

# Optional gallery toggles
# TOWER_GALLERY_SUBMIT_DISABLED=1
# VITE_TOWER_GALLERY_DISABLED=1
# Comma-separated Supabase auth user UUIDs — Gallery admin in Tools / Settings (list all builds, delete)
# TOWER_GALLERY_ADMIN_USER_IDS=your-supabase-user-uuid

# Twitch gallery sign-in: configure the Twitch provider in Supabase Auth (no extra env vars here).
