# Copy to `.env` for local dev. Never commit `.env`.
# Full setup: README.md (gallery, Effective Paths, OAuth troubleshooting).

# Supabase — required for auth + gallery (https://supabase.com/dashboard)
# All four values must be from the same project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Effective Paths (Google Sheets) — browser / Vite
# GCP: enable Sheets, Drive, and Picker APIs. Use separate OAuth Web clients for
# production (HTTPS only) vs local dev. Details in README.md.
# Diagnose: node scripts/check-google-picker-key.mjs
VITE_GOOGLE_SHEETS_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_PICKER_API_KEY=your-browser-api-key
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=123456789012

# Effective Paths — Netlify Functions only (never expose in Vite / browser)
GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=your-client-secret

# Optional
# GOOGLE_SHEETS_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VITE_PUBLIC_APP_ORIGIN=https://www.towersmith.com
# VITE_DEV_PUBLIC_ORIGIN=http://192.168.1.42:8888
# TOWER_GALLERY_ADMIN_USER_IDS=your-supabase-user-uuid
# TOWER_GALLERY_SUBMIT_DISABLED=1
# VITE_TOWER_GALLERY_DISABLED=1
# VITE_TOWER_GALLERY_API=/api
# GOOGLE_RISC_OAUTH_CLIENT_IDS=prod-id.apps.googleusercontent.com,dev-id.apps.googleusercontent.com

# Twitch sign-in: configure provider in Supabase Auth (no env vars).
# RISC registration: npm run register-google-risc (see script for one-time env vars).
